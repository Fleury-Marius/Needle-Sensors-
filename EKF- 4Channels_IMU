/* ---------------- Scalar Kalman (output smoothing) ------------------ */

void kalmanInit(KalmanFilter *kf, float process_noise, float measurement_noise, float initial_p)
{
    kf->q = process_noise;
    kf->r = measurement_noise;
    kf->x = 0.0f;
    kf->p = initial_p;
}

float kalmanUpdate(KalmanFilter *kf, float measurement)
{
    kf->p = kf->p + kf->q;
    kf->k = kf->p / (kf->p + kf->r);
    kf->x = kf->x + kf->k * (measurement - kf->x);
    kf->p = (1.0f - kf->k) * kf->p;
    return kf->x;
}

KalmanFilter kf_acc_x, kf_acc_y, kf_acc_z;
KalmanFilter kf_gyro_x, kf_gyro_y, kf_gyro_z;
KalmanFilter kf_dist, kf_dist2, kf_dist3, kf_dist4;

/* ---------------- Position / velocity filter ------------------------ */

void posvelInit(PosVelKF *kf, float pos0, float vel0, float pos_var0, float vel_var0)
{
    kf->pos = pos0;
    kf->vel = vel0;
    kf->P[0][0] = pos_var0; kf->P[0][1] = 0.0f;
    kf->P[1][0] = 0.0f;     kf->P[1][1] = vel_var0;
}

void posvelPredict(PosVelKF *kf, float accel, float dt, float q_accel_var)
{
    kf->pos += kf->vel * dt + 0.5f * accel * dt * dt;
    kf->vel += accel * dt;

    // Backstop against a corrupt sample that slips past the guard: a hand
    // or needle never exceeds ~2 m/s. Clamp velocity to that, so a single
    // bad acceleration cannot integrate position off to tens of metres
    // (as seen when pz ran to -23000). Real motion is unaffected.
    const float VEL_MAX_MMS = 2000.0f;   // 2 m/s
    if (kf->vel >  VEL_MAX_MMS) kf->vel =  VEL_MAX_MMS;
    if (kf->vel < -VEL_MAX_MMS) kf->vel = -VEL_MAX_MMS;

    float dt2 = dt * dt;
    float dt3 = dt2 * dt;
    float dt4 = dt3 * dt;

    float Qpp = 0.25f * dt4 * q_accel_var;
    float Qpv = 0.5f  * dt3 * q_accel_var;
    float Qvv = dt2 * q_accel_var;

    float P00 = kf->P[0][0], P01 = kf->P[0][1];
    float P10 = kf->P[1][0], P11 = kf->P[1][1];

    kf->P[0][0] = P00 + dt * (P01 + P10) + dt2 * P11 + Qpp;
    kf->P[0][1] = P01 + dt * P11 + Qpv;
    kf->P[1][0] = P10 + dt * P11 + Qpv;
    kf->P[1][1] = P11 + Qvv;
}

// THE STEP THAT WAS MISSING WITHOUT THE DISTANCE SENSORS.
// Standard scalar measurement update for the 2-state filter, H = [1 0]:
// an observation of position also corrects velocity, through the
// position/velocity covariance the predict step has been building up.
void posvelCorrect(PosVelKF *kf, float z_pos, float meas_var)
{
    float S  = kf->P[0][0] + meas_var;
    if (S <= 0.0f) return;
    float K0 = kf->P[0][0] / S;
    float K1 = kf->P[1][0] / S;

    float innov = z_pos - kf->pos;
    kf->pos += K0 * innov;
    kf->vel += K1 * innov;

    float P00 = kf->P[0][0], P01 = kf->P[0][1];
    float P10 = kf->P[1][0], P11 = kf->P[1][1];

    kf->P[0][0] = P00 - K0 * P00;
    kf->P[0][1] = P01 - K0 * P01;
    kf->P[1][0] = P10 - K1 * P00;
    kf->P[1][1] = P11 - K1 * P01;
}

void posvelZUPT(PosVelKF *kf, float vel_var_after_zupt)
{
    kf->vel = 0.0f;
    kf->P[1][1] = vel_var_after_zupt;
    kf->P[0][1] = 0.0f;
    kf->P[1][0] = 0.0f;
}

void posvelLeak(PosVelKF *kf, float leak)
{
    kf->vel *= leak;
}

PosVelKF kf_pos_x, kf_pos_y, kf_pos_z;

/* ================= ORIENTATION EKF (7-state) =========================
 * State x = [ q0 q1 q2 q3  bx by bz ]
 *   q = orientation quaternion (body -> world), bx/by/bz = gyro bias (rad/s)
 *
 * PREDICT: integrate the gyro (minus estimated bias) through the quaternion
 *          kinematics - this is the nonlinear part an EKF exists to handle.
 * CORRECT: two measurement updates -
 *   (a) accelerometer gives the gravity direction -> corrects roll & pitch
 *   (b) magnetometer gives the north direction   -> corrects yaw (absolute)
 * The gyro-bias states let the filter learn and subtract drift, which is
 * what actually sharpens fast-rotation tracking over time.
 *
 * Full 9-DOF as requested. Sized for the UNO: state 7, P is 7x7 (196 B),
 * ~750 B working set total. Position stays in the separate linear KF.
 *
 * WHY ROLL/PITCH ONLY BY DEFAULT: (b) needs an absolute world reference
 * for yaw, which the magnetometer is supposed to supply, but that only
 * works once two separate problems are solved - see USE_EKF_MAG_YAW
 * below. Until then the EKF corrects roll/pitch (the axes that decide
 * how precisely the needle's ANGLE is tracked) and yaw is left to the
 * GY-95T's own pre-fused output, same as before.
 * ------------------------------------------------------------------- */
#define USE_ORIENTATION_EKF 1   // ON: fuse gyro + accel into our own
                                //  quaternion for roll/pitch. Continuous
                                //  gravity-vector correction bounds the
                                //  gyro-integration error that pure
                                //  integration accumulates while the
                                //  needle is held at an angle, and the
                                //  bias states (bx/by/bz) let the filter
                                //  learn and subtract the gyro's own
                                //  steady-state drift over time - this is
                                //  the actual fix for "moves at an angle,
                                //  drifts, doesn't track precisely."

// Whether the EKF ALSO corrects yaw from the magnetometer. OFF by default -
// two real problems have to be solved first, not just left for later:
//   1. FRAME MISMATCH. The mag correction assumes world +X is magnetic
//      north. Everything else in this sketch (ZERO_YAW_AT_START,
//      BEAM1/BEAM2_BODY_*) defines world axes as "wherever the device was
//      pointing at power-on" - essentially never magnetic north. Turn mag
//      yaw on without fixing this and the EKF spends every sample
//      dragging yaw toward compass north while the range-correction beams
//      stay wired to the power-on heading; the two disagree more the
//      further apart those two directions happen to be.
//   2. NO HARD/SOFT-IRON CALIBRATION. my_95Q.mag_x/y/z are raw. On a
//      small board like this they are dominated by local anomalies
//      (traces, nearby metal), not the earth's field, so an uncalibrated
//      absolute yaw correction can inject more error than it removes.
// Until both are solved, yaw is left alone: only roll/pitch - the axes
// that actually decide needle-tilt precision - come from the EKF; yaw
// keeps coming from the GY-95T's own pre-fused fusion (referencedYaw()),
// same as when the EKF is off.
#define USE_EKF_MAG_YAW      0

OriEKF ekf;
// EKF Euler output, published for the serial printer (which runs in a
// separate function and can't see the update's locals).
float g_ori_roll = 0, g_ori_pitch = 0, g_ori_yaw = 0;
// Yaw value the EKF itself reported right after ekfSeedFromAccelMag() ran,
// captured once so a later "zero yaw at start" subtraction stays inside
// the EKF's OWN reference frame. yaw_ref_deg (below) is captured from the
// GY-95T's separate internal fusion during calibrate() and lives in a
// different frame (mag-referenced vs. whatever the module's fusion calls
// zero) - subtracting one from the other produces a meaningless offset.
// Only used if USE_EKF_MAG_YAW is ever turned on.
float ekf_yaw_ref_deg = 0.0f;

static void ekf_normalize(OriEKF *f)
{
    float n = sqrt(f->q0*f->q0 + f->q1*f->q1 + f->q2*f->q2 + f->q3*f->q3);
    if (n > 1e-9f) { f->q0/=n; f->q1/=n; f->q2/=n; f->q3/=n; }
}

void ekfInit(OriEKF *f)
{
    f->q0 = 1; f->q1 = f->q2 = f->q3 = 0;
    f->bx = f->by = f->bz = 0;
    for (int i=0;i<7;i++) for (int j=0;j<7;j++) f->P[i][j] = 0;
    for (int i=0;i<4;i++) f->P[i][i] = 0.01f;   // quat uncertainty
    for (int i=4;i<7;i++) f->P[i][i] = 0.001f;  // bias uncertainty
    f->Qg = 1e-4f;   // gyro process noise (tune)
    f->Qb = 1e-7f;   // bias walk (tune)
    f->Ra = 0.5f;    // accel trust (higher = trust gyro more)
    f->Rm = 1.0f;    // mag trust (mag is noisier)
    f->inited = true;
}

/* Seed the quaternion from the first accel+mag reading so we don't start
 * 180 deg off and spend seconds converging. */
void ekfSeedFromAccelMag(OriEKF *f, float ax, float ay, float az,
                                    float mx, float my, float mz)
{
    // roll/pitch from gravity
    float roll  = atan2(ay, az);
    float pitch = atan2(-ax, sqrt(ay*ay + az*az));
    // tilt-compensated heading from mag
    float cr = cos(roll),  sr = sin(roll);
    float cp = cos(pitch), sp = sin(pitch);
    float mxh = mx*cp + my*sr*sp + mz*cr*sp;
    float myh = my*cr - mz*sr;
    float yaw = atan2(-myh, mxh);
    // euler -> quaternion
    float cy=cos(yaw*0.5f), sy=sin(yaw*0.5f);
    float cpi=cos(pitch*0.5f), spi=sin(pitch*0.5f);
    float crl=cos(roll*0.5f), srl=sin(roll*0.5f);
    f->q0 = crl*cpi*cy + srl*spi*sy;
    f->q1 = srl*cpi*cy - crl*spi*sy;
    f->q2 = crl*spi*cy + srl*cpi*sy;
    f->q3 = crl*cpi*sy - srl*spi*cy;
    ekf_normalize(f);
}

/* PREDICT: propagate quaternion with bias-corrected gyro over dt. */
void ekfPredict(OriEKF *f, float gx, float gy, float gz, float dt)
{
    // bias-corrected rates
    float wx = gx - f->bx, wy = gy - f->by, wz = gz - f->bz;

    // quaternion derivative qdot = 0.5 * q (x) w
    float q0=f->q0,q1=f->q1,q2=f->q2,q3=f->q3;
    float dq0 = 0.5f*(-q1*wx - q2*wy - q3*wz);
    float dq1 = 0.5f*( q0*wx + q2*wz - q3*wy);
    float dq2 = 0.5f*( q0*wy - q1*wz + q3*wx);
    float dq3 = 0.5f*( q0*wz + q1*wy - q2*wx);
    f->q0 += dq0*dt; f->q1 += dq1*dt; f->q2 += dq2*dt; f->q3 += dq3*dt;
    ekf_normalize(f);

    // Covariance predict: P = F P F^T + Q, with F ~ I + dF*dt.
    // For the UNO we use a practical simplification: inflate the quaternion
    // block by process noise and the bias block by random walk, plus the
    // dominant cross terms. This keeps the filter stable and cheap without
    // a full 7x7 Jacobian multiply every sample (which the 8-bit MCU can't
    // afford at rate). This is a standard reduced-Jacobian EKF for MCUs.
    for (int i=0;i<4;i++) f->P[i][i] += f->Qg + 0.25f*dt*dt*(
                          f->P[4][4]+f->P[5][5]+f->P[6][6]);
    for (int i=4;i<7;i++) f->P[i][i] += f->Qb;
    // couple quat<->bias (gyro integrates bias into attitude)
    for (int i=0;i<4;i++) for (int j=4;j<7;j++) {
        f->P[i][j] += -0.5f*dt*f->P[j][j];
        f->P[j][i] = f->P[i][j];
    }
}

/* CORRECT with a unit reference vector (accel=gravity or mag=north).
 * Measures the direction the body should see and nudges the quaternion so
 * the predicted direction matches the measured one. Scalar-per-axis update
 * keeps the math within the UNO's budget. */
static void ekfCorrectVector(OriEKF *f,
                             float mxb, float myb, float mzb,   // measured (body)
                             float rxw, float ryw, float rzw,   // reference (world)
                             float R)
{
    // normalize measurement
    float n = sqrt(mxb*mxb+myb*myb+mzb*mzb);
    if (n < 1e-6f) return;
    mxb/=n; myb/=n; mzb/=n;

    // rotate world reference into body frame using current quaternion
    float q0=f->q0,q1=f->q1,q2=f->q2,q3=f->q3;
    // R_wb = transpose of body->world
    float ex = (1-2*(q2*q2+q3*q3))*rxw + 2*(q1*q2+q0*q3)*ryw + 2*(q1*q3-q0*q2)*rzw;
    float ey = 2*(q1*q2-q0*q3)*rxw + (1-2*(q1*q1+q3*q3))*ryw + 2*(q2*q3+q0*q1)*rzw;
    float ez = 2*(q1*q3+q0*q2)*rxw + 2*(q2*q3-q0*q1)*ryw + (1-2*(q1*q1+q2*q2))*rzw;

    // innovation = measured (body) - predicted (body), as a small rotation
    // (cross product gives the axis/angle error)
    float errx = myb*ez - mzb*ey;
    float erry = mzb*ex - mxb*ez;
    float errz = mxb*ey - myb*ex;

    // gain: pull quaternion vector part toward correcting the error.
    // Scalar Kalman-style gain per axis from the quaternion covariance.
    float Pq = (f->P[1][1]+f->P[2][2]+f->P[3][3]) / 3.0f;
    float K = Pq / (Pq + R);

    // apply correction as a small quaternion nudge
    float cx = 0.5f*K*errx, cy = 0.5f*K*erry, cz = 0.5f*K*errz;
    float nq0 = q0 - (q1*cx + q2*cy + q3*cz);
    float nq1 = q1 + (q0*cx + q2*cz - q3*cy);
    float nq2 = q2 + (q0*cy - q1*cz + q3*cx);
    float nq3 = q3 + (q0*cz + q1*cy - q2*cx);
    f->q0=nq0; f->q1=nq1; f->q2=nq2; f->q3=nq3;
    ekf_normalize(f);

    // feed a little of the error into the bias estimate (drift learning)
    f->bx += 1e-3f*K*errx;
    f->by += 1e-3f*K*erry;
    f->bz += 1e-3f*K*errz;

    // shrink covariance
    for (int i=1;i<4;i++) f->P[i][i] *= (1.0f - K);
}

/* Read the EKF out as Euler angles (deg) for display + the world-frame
 * rotation the position pipeline needs. */
void ekfEuler(OriEKF *f, float *roll_deg, float *pitch_deg, float *yaw_deg)
{
    float q0=f->q0,q1=f->q1,q2=f->q2,q3=f->q3;
    *roll_deg  = atan2(2*(q0*q1+q2*q3), 1-2*(q1*q1+q2*q2)) * 57.29578f;
    *pitch_deg = asin( 2*(q0*q2-q3*q1)) * 57.29578f;
    *yaw_deg   = atan2(2*(q0*q3+q1*q2), 1-2*(q2*q2+q3*q3)) * 57.29578f;
}

/* ---------------- Stationary detector ------------------------------- */

float acc_hist[STAT_WIN];
float gyr_hist[STAT_WIN];
uint8_t hist_i = 0;
uint8_t hist_n = 0;

float tol_acc_offset = 0.02f;
float tol_acc_std    = 0.01f;
float tol_gyro       = 5.0f;

void statPush(float acc_mag_g, float gyro_mag_dps)
{
    acc_hist[hist_i] = acc_mag_g;
    gyr_hist[hist_i] = gyro_mag_dps;
    hist_i = (hist_i + 1) % STAT_WIN;
    if (hist_n < STAT_WIN) hist_n++;
}

bool statIsStationary()
{
    if (hist_n < STAT_WIN) return false;

    float mean_a = 0.0f, mean_g = 0.0f;
    for (uint8_t i = 0; i < STAT_WIN; i++) { mean_a += acc_hist[i]; mean_g += gyr_hist[i]; }
    mean_a /= STAT_WIN;
    mean_g /= STAT_WIN;

    float var_a = 0.0f;
    for (uint8_t i = 0; i < STAT_WIN; i++) {
        float d = acc_hist[i] - mean_a;
        var_a += d * d;
    }
    var_a /= STAT_WIN;

    return (fabs(mean_a - 1.0f) < tol_acc_offset)
        && (sqrt(var_a)        < tol_acc_std)
        && (mean_g             < tol_gyro);
}

