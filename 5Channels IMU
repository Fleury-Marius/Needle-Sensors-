    if (sensor5_present && rangePoll(sensor5, &mm)) {
        dist5_mm  = (mm < 0) ? -1.0f : kalmanUpdate(&kf_dist5, (float)mm);
        dist5_fresh = true;
        dist5_ms = now;
    }
}

void setupRangeSensors()
{
    pinMode(SENSOR1_SHUT_PIN, OUTPUT);
    pinMode(SENSOR2_SHUT_PIN, OUTPUT);
    pinMode(SENSOR3_SHUT_PIN, OUTPUT);
    pinMode(SENSOR4_SHUT_PIN, OUTPUT);
    pinMode(SENSOR5_SHUT_PIN, OUTPUT);

    // All power up at 0x29, so only one may be awake at a time until it has
    // been given a unique address. Hold all in reset, then bring them up one
    // by one: sensor 4 (0x32), sensor 3 (0x31), sensor 2 (0x30), then sensor
    // 1 last (keeps the default 0x29).
    digitalWrite(SENSOR1_SHUT_PIN, LOW);
    digitalWrite(SENSOR2_SHUT_PIN, LOW);
    digitalWrite(SENSOR3_SHUT_PIN, LOW);
    digitalWrite(SENSOR4_SHUT_PIN, LOW);
    digitalWrite(SENSOR5_SHUT_PIN, LOW);
    delay(20);

    digitalWrite(SENSOR5_SHUT_PIN, HIGH);
    delay(20);
    sensor5.setTimeout(200);
    sensor5.init();
    sensor5.configureDefault();
    sensor5.setScaling(RANGE_SCALING);
    sensor5.setAddress(SENSOR5_ADDRESS);
    sensor5_present = !sensor5.timeoutOccurred();

    digitalWrite(SENSOR4_SHUT_PIN, HIGH);
    delay(20);
    sensor4.setTimeout(200);
    sensor4.init();
    sensor4.configureDefault();
    sensor4.setScaling(RANGE_SCALING);
    sensor4.setAddress(SENSOR4_ADDRESS);
    sensor4_present = !sensor4.timeoutOccurred();

    digitalWrite(SENSOR3_SHUT_PIN, HIGH);
    delay(20);
    sensor3.setTimeout(200);
    sensor3.init();
    sensor3.configureDefault();
    sensor3.setScaling(RANGE_SCALING);
    sensor3.setAddress(SENSOR3_ADDRESS);
    sensor3_present = !sensor3.timeoutOccurred();

    digitalWrite(SENSOR2_SHUT_PIN, HIGH);
    delay(20);
    sensor2.setTimeout(200);
    sensor2.init();
    sensor2.configureDefault();
    sensor2.setScaling(RANGE_SCALING);
    sensor2.setAddress(SENSOR2_ADDRESS);
    sensor2_present = !sensor2.timeoutOccurred();

    digitalWrite(SENSOR1_SHUT_PIN, HIGH);
    delay(20);
    sensor1.setTimeout(200);
    sensor1.init();
    sensor1.configureDefault();
    sensor1.setScaling(RANGE_SCALING);
    sensor1_present = !sensor1.timeoutOccurred();

    // Continuous mode: the sensors range on their own schedule and we
    // collect whatever is ready. No blocking waits in the main loop.
    if (sensor1_present) sensor1.startRangeContinuous(RANGE_PERIOD_MS);
    if (sensor2_present) sensor2.startRangeContinuous(RANGE_PERIOD_MS);
    if (sensor3_present) sensor3.startRangeContinuous(RANGE_PERIOD_MS);
    if (sensor4_present) sensor4.startRangeContinuous(RANGE_PERIOD_MS);
    if (sensor5_present) sensor5.startRangeContinuous(RANGE_PERIOD_MS);

#if VERBOSE_STARTUP
    Serial.print(F("# VL6180X s1="));
    Serial.print(sensor1_present ? F("ok") : F("MISSING"));
    Serial.print(F(" s2="));
    Serial.print(sensor2_present ? F("ok") : F("MISSING"));
    Serial.print(F(" s3="));
    Serial.print(sensor3_present ? F("ok") : F("MISSING"));
    Serial.print(F(" s4="));
    Serial.print(sensor4_present ? F("ok") : F("MISSING"));
    Serial.print(F(" s5="));
    Serial.println(sensor5_present ? F("ok") : F("MISSING"));
    if (!sensor1_present || !sensor2_present || !sensor3_present ||
        !sensor4_present || !sensor5_present) {
        Serial.println(F("# Check SHUT pins 4/5/6/7/8, power, and the bus."));
    }
#endif
}

/* ---------------- Range-aided position correction ------------------- */

#if USE_RANGE_CORRECTION

// Correct one axis given the beam's component along it. This is the
// standard Kalman update for a measurement of a PROJECTION of position,
// H = [ux 0 uy 0 uz 0], split across three independent per-axis filters.
// A single joint 6-state filter would also build cross-axis covariance;
// we ignore that, which is the usual pragmatic simplification and costs
// little when the beam is close to one axis.
void correctAxisAlongBeam(PosVelKF *kf, float u, float innov, float S)
{
    if (u == 0.0f || S <= 0.0f) return;

    float K0 = kf->P[0][0] * u / S;
    float K1 = kf->P[1][0] * u / S;

    kf->pos += K0 * innov;
    kf->vel += K1 * innov;      // correcting position corrects velocity too

    float HP0 = u * kf->P[0][0];
    float HP1 = u * kf->P[0][1];
    kf->P[0][0] -= K0 * HP0;
    kf->P[0][1] -= K0 * HP1;
    kf->P[1][0] -= K1 * HP0;
    kf->P[1][1] -= K1 * HP1;
}

// Effective measurement variance (R) for a channel, scaled by how much we
// trust it right now. Your idea: when a sensor isn't solidly locked on a
// target, its reading is unreliable, so we inflate R a LOT (or effectively
// drop it) - which makes the Kalman gain tiny and lets the IMU dead-reckon
// instead of being yanked by a bad range value.
//   state 2 (locked)   -> full trust, R = base
//   state 1 (settling) -> low trust,  R = base x 25  (weak correction)
//   state 3 (rejected) / anything else / not anchored -> essentially ignored
// Returns a very large R for untrusted channels so their correction is
// negligible without needing a separate code path.
float getRangeR(const RangeChannel *ch)
{
    if (!ch->anchored)      return 1.0e9f;      // no anchor: ignore entirely
    switch (ch->state) {
        case 2:  return RANGE_MEAS_VAR;         // locked: full trust
        case 1:  return RANGE_MEAS_VAR * 25.0f; // settling: weak trust
        default: return 1.0e9f;                 // rejected/idle: ignore
    }
}

// Anchor, gate and apply one channel along its own beam.
// `stationary` comes from the IMU. When true we trust the accelerometer's
// verdict (no motion) over the rangefinder, because a range change while
// physically still can only be the target moving - e.g. a hand.
void updateRangeChannel(RangeChannel *ch, float ux, float uy, float uz,
                        float d, bool stationary)
{
    // Horizontal sensors (X, Y) get their vertical leakage removed so a
    // tilt cannot bleed their correction into Z. The vertical sensor is
    // exempt - correcting Z is its whole job.
    if (ch->horizontal_only) {
        uz = 0.0f;
        float hmag = sqrt(ux*ux + uy*uy);
        if (hmag < 0.3f) { ch->state = 0; return; }  // too vertical to use
        ux /= hmag; uy /= hmag;
    } else {
        // Vertical channel: strip any horizontal leakage instead, so a
        // tilt cannot bleed the up-sensor into X or Y. Bail if the beam
        // has tilted too far from vertical to mean anything.
        ux = 0.0f; uy = 0.0f;
        float vmag = fabs(uz);
        if (vmag < 0.3f) { ch->state = 0; return; }  // too horizontal to use
        uz = (uz > 0.0f) ? 1.0f : -1.0f;
    }

    float p_along = kf_pos_x.pos * ux + kf_pos_y.pos * uy + kf_pos_z.pos * uz;

#if RANGE_TRUST_WHILE_MOVING_ONLY
    // If ZUPT says the needle is physically still, a changing range cannot
    // be self-motion. Treat the current range as the new local baseline and
    // do not feed any correction into position/velocity. This stops a hand,
    // phantom, or nearby object moving toward the sensor from dragging the
    // needle toward it while stationary.
    if (stationary) {
        ch->anchor_C = p_along + d;
        ch->anchored = true;
        ch->last_mm = d;
        ch->prev_mm = d;
        ch->innov = 0.0f;
        ch->reject_count = 0;
        ch->stable_since_ms = millis();
        ch->state = 2;             // locked/idle; ZUPT is holding position
        return;
    }
#endif

    // --- Jump guard: a hand entering the beam is a step, not motion. ---
    // Real motion changes the range smoothly between samples. A single
    // large jump means the target itself changed, so freeze this channel
    // and let the reading settle rather than believing the step.
    if (ch->prev_mm >= 0.0f && fabs(d - ch->prev_mm) > RANGE_JUMP_MAX) {
        ch->prev_mm = d;
        ch->state = 3;             // rejected: target jumped
        // A jump also invalidates the surface we anchored to - re-anchor.
        ch->anchored = false;
        ch->stable_since_ms = 0;
        return;
    }
    ch->prev_mm = d;

    if (!ch->anchored) {
        if (ch->last_mm < 0.0f || fabs(d - ch->last_mm) > RANGE_STABLE_MM) {
            ch->stable_since_ms = 0;
        } else if (ch->stable_since_ms == 0) {
            ch->stable_since_ms = millis();
        }
        ch->last_mm = d;

        if (ch->stable_since_ms == 0
            || millis() - ch->stable_since_ms < RANGE_ANCHOR_MS) {
            ch->state = 1;
            return;
        }

        ch->anchor_C = p_along + d;
        ch->anchored = true;
        ch->reject_count = 0;
    }
    ch->last_mm = d;

    ch->innov = (ch->anchor_C - d) - p_along;

    // --- Apply only when the innovation is above the noise floor ---------
    // innov is the accumulated disagreement between what the range sensor
    // measures and what the position estimate predicts, measured from the
    // STABLE anchor set at lock time. It is allowed to GROW across samples,
    // so even a slow push (small change per sample) eventually clears the
    // floor and gets corrected. The anchor is NOT reset here - resetting it
    // when the reading looked flat was the bug that pinned innov at 0 and
    // made forward motion invisible.
    if (fabs(ch->innov) < RANGE_FLAT_MM) {
        ch->state = 2;                // locked, idle (below noise floor)
        ch->reject_count = 0;
        return;
    }

    // Outlier gate: an innovation this large means the surface premise
    // broke (edge crossing, target moved, or a jump). Reject it; if it
    // persists, the old anchor is stale so adopt the current reading.
    if (fabs(ch->innov) > RANGE_INNOV_MAX) {
        ch->state = 3;
        if (++ch->reject_count > RANGE_REJECT_MAX) {
            ch->anchor_C = p_along + d;      // stale reference; adopt current
            ch->reject_count = 0;
        }
        return;
    }
    ch->reject_count = 0;
    ch->state = 2;   // reached a valid correction: mark locked BEFORE computing
                     // R, so getRangeR() reports full trust for this update.

    float S = ux * ux * kf_pos_x.P[0][0]
            + uy * uy * kf_pos_y.P[0][0]
            + uz * uz * kf_pos_z.P[0][0]
            + getRangeR(ch);     // adaptive: full trust locked, huge R if not

    correctAxisAlongBeam(&kf_pos_x, ux, ch->innov, S);
    correctAxisAlongBeam(&kf_pos_y, uy, ch->innov, S);
    correctAxisAlongBeam(&kf_pos_z, uz, ch->innov, S);
}

void resetChannel(RangeChannel *ch)
{
    ch->state = 0;
    ch->anchored = false;
    ch->stable_since_ms = 0;
    ch->last_mm = -1.0f;
    ch->prev_mm = -1.0f;
    ch->innov = 0.0f;
    ch->reject_count = 0;
}

void resetAllRangeChannels()
{
    resetChannel(&ch1);
    resetChannel(&ch2);
    resetChannel(&ch3);
    resetChannel(&ch4);
    resetChannel(&ch5);
    dist1_fresh = dist2_fresh = dist3_fresh = dist4_fresh = dist5_fresh = false;
}

void consumeRangeSample(RangeChannel *ch, float ux, float uy, float uz,
                        float d, bool *fresh, unsigned long last_ms,
                        bool stationary)
{
    if (*fresh) {
        *fresh = false;
        if (d >= 0.0f) updateRangeChannel(ch, ux, uy, uz, d, stationary);
        else           resetChannel(ch);
        return;
    }

    // A locked channel with no recent fresh samples is stale. Drop the lock
    // instead of letting an old distance keep suppressing position leakage.
    if (ch->anchored && millis() - last_ms > RANGE_STALE_MS) {
        resetChannel(ch);
    }
}

void applyRangeCorrection(bool is_stationary)
{
    // Rotate each beam from the body frame into the world frame using the
    // current fused orientation. This keeps every correction landing on
    // the right world axis even as the syringe tilts and turns.
    float u1x, u1y, u1z, u2x, u2y, u2z, u3x, u3y, u3z;
    rotateBodyToWorld(ch1.bx, ch1.by, ch1.bz,
                      my_95Q.roll / 100.0f, my_95Q.pitch / 100.0f,
                      referencedYaw(), &u1x, &u1y, &u1z);
    rotateBodyToWorld(ch2.bx, ch2.by, ch2.bz,
                      my_95Q.roll / 100.0f, my_95Q.pitch / 100.0f,
                      referencedYaw(), &u2x, &u2y, &u2z);
    rotateBodyToWorld(ch3.bx, ch3.by, ch3.bz,
                      my_95Q.roll / 100.0f, my_95Q.pitch / 100.0f,
                      referencedYaw(), &u3x, &u3y, &u3z);
    float u4x, u4y, u4z;
    rotateBodyToWorld(ch4.bx, ch4.by, ch4.bz,
                      my_95Q.roll / 100.0f, my_95Q.pitch / 100.0f,
                      referencedYaw(), &u4x, &u4y, &u4z);
    float u5x, u5y, u5z;
    rotateBodyToWorld(ch5.bx, ch5.by, ch5.bz,
                      my_95Q.roll / 100.0f, my_95Q.pitch / 100.0f,
                      referencedYaw(), &u5x, &u5y, &u5z);

    consumeRangeSample(&ch1, u1x, u1y, u1z, dist1_mm, &dist1_fresh, dist1_ms, is_stationary);

    // --- X-axis differential pair: sensor 2 (+X) and sensor 4 (-X) --------
    // They face opposite ways, so a leftward move shrinks one beam's range
    // and grows the other's by the same amount. Both channels correct the
    // SAME world X axis (updateRangeChannel projects each beam onto its own
    // axis, and here both project onto X), so applying both when valid lets
    // their independent noise average out - a true differential measurement
    // that cancels error common to both. When only one sees a surface, that
    // one still corrects alone (redundancy / blind-spot coverage).
    consumeRangeSample(&ch2, u2x, u2y, u2z, dist2_mm, &dist2_fresh, dist2_ms, is_stationary);

    consumeRangeSample(&ch4, u4x, u4y, u4z, dist4_mm, &dist4_fresh, dist4_ms, is_stationary);

    // Second forward (+Y) sensor - independent channel (redundancy + noise
    // averaging on forward). Its DIFFERENCE from ch2 gives surface yaw angle,
    // computed/printed separately, not applied as a position correction.
    consumeRangeSample(&ch5, u5x, u5y, u5z, dist5_mm, &dist5_fresh, dist5_ms, is_stationary);

    consumeRangeSample(&ch3, u3x, u3y, u3z, dist3_mm, &dist3_fresh, dist3_ms, is_stationary);
}
#endif  // USE_RANGE_CORRECTION

/* ---------------- Sample acquisition -------------------------------- */

bool sampleReady()
{
    if (ready_Ok) {
        ready_Ok = 0;
        return true;
    }
#if USE_POLL_FALLBACK
    if (millis() - last_sample_ms >= (unsigned long)(delay_t)) return true;
#endif
    return false;
}

// Reject a sample whose contents are physically impossible - the
// signature of a corrupted I2C read on a marginal bus (floating lines,
// loose breadboard jumpers). Seen in captures: roll/pitch/yaw snapping to
// exactly 0.0 mid-motion, magnetometer jumping to thousands, accel
// magnitude collapsing to ~0.5 g. Integrating even one such sample throws
// position metres off. This is a SEATBELT, not a fix - proper pull-up
// resistors on SDA/SCL are the real cure - but it stops one bad read from
// destroying the whole track.
// Master switch for the corruption guard. Default OFF - it was rejecting
// good data on some setups, and a rejected-everything guard is worse than
// no guard. Turn ON only if you see position explode from bus corruption,
// and watch the "# corrupt reason=" line to confirm it's catching real
// garbage and not eating clean samples.
// Guard ON, but only the SAFE checks. Last time it rejected good data
// because the accel/mag bounds were too tight; those are now widened and,
// more importantly, the PRIMARY check is the one that never false-fires:
// roll==pitch==yaw==EXACTLY 0.0, which real fused output never produces
// but a corrupt I2C read does (seen repeatedly in captures, right before
// pz explodes). This alone stops the runaway that has wrecked every long
// capture. The accel/mag checks are backups with generous bounds.
#define USE_CORRUPTION_GUARD 1

// When the guard is on, this records why the last rejection happened:
//   1 orientation exactly 0/0/0   2 accel magnitude out of band
//   3 magnetometer out of envelope
uint8_t corrupt_reason = 0;

bool sampleLooksCorrupt()
{
#if !USE_CORRUPTION_GUARD
    return false;                       // guard disabled
#else
    // 1. Orientation exactly zero on all three axes.
    if (my_95Q.roll == 0 && my_95Q.pitch == 0 && my_95Q.yaw == 0) {
        corrupt_reason = 1; return true;
    }

    // 2. Accel magnitude far from 1 g. Wide band so brisk motion is fine.
    float ax = my_95Q.acc_x * ACC_SCALE;
    float ay = my_95Q.acc_y * ACC_SCALE;
    float az = my_95Q.acc_z * ACC_SCALE;
    float amag = sqrt(ax*ax + ay*ay + az*az);
    if (amag < 0.4f || amag > 3.0f) {   // widened from 0.5-2.5
        corrupt_reason = 2; return true;
    }

    // 3. Magnetometer wildly out of envelope.
    if (abs(my_95Q.mag_x) > 5000 || abs(my_95Q.mag_y) > 5000
        || abs(my_95Q.mag_z) > 5000) {  // widened from 3000
        corrupt_reason = 3; return true;
    }

    return false;
#endif
}

bool readIMU()
{
    unsigned char data[27] = {0};
    if (!iic_read(0x08, data, 27)) {
        i2c_fail_count++;
        return false;
    }
    memcpy(&my_95Q, data, 27);

    if (sampleLooksCorrupt()) {
        corrupt_count++;
        // Do NOT update last_sample_ms/sample_count or integrate: treat it
        // as if the sample never arrived. The filter simply pauses for this
        // frame and resumes on the next clean one.
        return false;
    }

    last_sample_ms = millis();
    sample_count++;
    return true;
}

// Single-character commands, typed into the Serial Monitor:
//   a = drop the anchor and re-establish it here
//   z = zero position and velocity
void serviceSerialCommands()
{
    while (Serial.available()) {
        char c = Serial.read();
        if (c == 'a' || c == 'A') {
            resetAllRangeChannels();
#if VERBOSE_STARTUP
            Serial.println(F("# Re-anchoring range reference..."));
#endif
        } else if (c == 'z' || c == 'Z') {
            posvelInit(&kf_pos_x, 0.0f, 0.0f, 1.0f, 1.0f);
            posvelInit(&kf_pos_y, 0.0f, 0.0f, 1.0f, 1.0f);
            posvelInit(&kf_pos_z, 0.0f, 0.0f, 1.0f, 1.0f);
            resetAllRangeChannels();
#if VERBOSE_STARTUP
            Serial.println(F("# Position zeroed."));
#endif
        }
    }
}

void serviceDiagnostics()
{
#if VERBOSE_STARTUP
    unsigned long now = millis();
    if (now - last_diag_ms < DIAG_PERIOD_MS) return;
    last_diag_ms = now;

    // If corrupt samples are being rejected, report the rate - this is the
    // live readout of bus health. A nonzero count means the guard is
    // catching bad I2C reads; a rising count means add pull-up resistors.
    if (corrupt_count > 0) {
        Serial.print(F("# rejected "));
        Serial.print(corrupt_count);
        Serial.print(F(" corrupt samples (last reason="));
        Serial.print(corrupt_reason);
        Serial.print(F(") in last "));
        Serial.print(DIAG_PERIOD_MS / 1000);
        Serial.println(F("s"));
        corrupt_count = 0;
    }

    if (sample_count > 0) { sample_count = 0; return; }

    Serial.print(F("# NO DATA. int_fires="));
    Serial.print(int_count);
    Serial.print(F(" i2c_fails="));
    Serial.print(i2c_fail_count);
    if (int_count == 0) Serial.print(F("  -> data-ready pin is not reaching D2"));
    else if (i2c_fail_count > 0) Serial.print(F("  -> I2C reads failing: check SDA/SCL, pull-ups, address"));
    Serial.println();
    i2c_fail_count = 0;
#endif
}

float clampFloat(float v, float lo, float hi)
{
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

float accelSoftDeadband(float a, float floor_mms2)
{
    if (fabs(a) <= floor_mms2) return 0.0f;
    return (a > 0.0f) ? (a - floor_mms2) : (a + floor_mms2);
}

/* ---------------- Startup calibration ------------------------------- */

void calibrate()
{
#if VERBOSE_STARTUP
    Serial.println(F("# Calibrating - hold the device COMPLETELY still for about 5 seconds..."));
#endif

    int   collected = 0;
    unsigned int rejected = 0;
    float sum_wx = 0, sum_wy = 0, sum_wz = 0;
    float sum_wx2 = 0, sum_wy2 = 0, sum_wz2 = 0;
    float sum_am = 0, sum_am2 = 0;
    float sum_gm = 0, sum_gm2 = 0;
    unsigned long cal_start = millis();
    unsigned long still_start = 0;

    while (collected < CAL_SAMPLES && millis() - cal_start < CAL_MAX_MS) {
        if (!sampleReady()) continue;
        if (!readIMU())     continue;

        float ax_g = my_95Q.acc_x * ACC_SCALE;
        float ay_g = my_95Q.acc_y * ACC_SCALE;
        float az_g = my_95Q.acc_z * ACC_SCALE;

        float am = sqrt(ax_g*ax_g + ay_g*ay_g + az_g*az_g);
        float gx  = my_95Q.gyro_x * GYRO_SCALE;
        float gy_ = my_95Q.gyro_y * GYRO_SCALE;
        float gz  = my_95Q.gyro_z * GYRO_SCALE;
        float gm  = sqrt(gx*gx + gy_*gy_ + gz*gz);

        // Startup bias only helps if the device is truly still. If it gets
        // bumped, throw away the partial average and start a fresh still
        // window instead of baking motion into the bias estimate.
        if (fabs(am - 1.0f) > CAL_STILL_ACC_G || gm > CAL_STILL_GYRO) {
            collected = 0;
            sum_wx = sum_wy = sum_wz = 0.0f;
            sum_wx2 = sum_wy2 = sum_wz2 = 0.0f;
            sum_am = sum_am2 = 0.0f;
            sum_gm = sum_gm2 = 0.0f;
            still_start = 0;
            rejected++;
            continue;
        }

        unsigned long now_ms = millis();
        if (still_start == 0) still_start = now_ms;
        if (now_ms - still_start < CAL_SETTLE_MS) continue;

        if (collected == 0) yaw_ref_deg = my_95Q.yaw / 100.0f;

        float wx, wy, wz;
        rotateBodyToWorld(ax_g, ay_g, az_g,
                          my_95Q.roll / 100.0f, my_95Q.pitch / 100.0f,
                          referencedYaw(), &wx, &wy, &wz);

        sum_wx += wx; sum_wy += wy; sum_wz += wz;
        sum_wx2 += wx * wx; sum_wy2 += wy * wy; sum_wz2 += wz * wz;
        sum_am += am; sum_am2 += am * am;
        sum_gm += gm; sum_gm2 += gm * gm;

        collected++;
    }

    sample_count = 0;

    if (collected < CAL_MIN_SAMPLES) {
#if VERBOSE_STARTUP
        Serial.print(F("# CALIBRATION FAILED. samples=")); Serial.print(collected);
        Serial.print(F(" target=")); Serial.print(CAL_SAMPLES);
        Serial.print(F(" rejected=")); Serial.print(rejected);
        Serial.print(F(" int_fires=")); Serial.print(int_count);
        Serial.print(F(" i2c_fails=")); Serial.println(i2c_fail_count);
        Serial.println(F("# Running anyway with zero bias."));
#endif
        return;
    }

    float n = (float)collected;

    float mean_wx = sum_wx / n;
    float mean_wy = sum_wy / n;
    float mean_wz = sum_wz / n;
    float std_wx  = sqrt(fmax(0.0f, sum_wx2 / n - mean_wx * mean_wx));
    float std_wy  = sqrt(fmax(0.0f, sum_wy2 / n - mean_wy * mean_wy));
    float std_wz  = sqrt(fmax(0.0f, sum_wz2 / n - mean_wz * mean_wz));
    float mean_am = sum_am / n;
    float std_am  = sqrt(fmax(0.0f, sum_am2 / n - mean_am * mean_am));
    float mean_gm = sum_gm / n;
    float std_gm  = sqrt(fmax(0.0f, sum_gm2 / n - mean_gm * mean_gm));

    // Scale correction first: at rest |a| must be exactly 1g, so the
    // factor that makes it so is the true scale error. This has to come
    // before the bias, because bias is what is left AFTER scaling.
    if (mean_am > 0.5f && mean_am < 1.5f) {
        acc_gain = 1.0f / mean_am;
        if (acc_gain < ACC_GAIN_MIN) acc_gain = ACC_GAIN_MIN;
        if (acc_gain > ACC_GAIN_MAX) acc_gain = ACC_GAIN_MAX;
    }

    // Sums were accumulated ungained; rotation is linear, so scaling the
    // averages afterwards is equivalent to having scaled every sample.
    acc_bias_world_x = mean_wx * acc_gain * ACC_G_TO_MMS2;
    acc_bias_world_y = mean_wy * acc_gain * ACC_G_TO_MMS2;
    acc_bias_world_z = (mean_wz * acc_gain - GRAVITY_SIGN * 1.0f) * ACC_G_TO_MMS2;

    // Per-axis still noise floor. Anything inside this band is more likely
    // sensor noise / residual bias than real motion, and should not be
    // double-integrated into position.
    acc_deadband_world_x = clampFloat(ACC_DEADBAND_SIGMAS * std_wx * acc_gain * ACC_G_TO_MMS2,
                                      ACC_DEADBAND_MIN, ACC_DEADBAND_MAX);
    acc_deadband_world_y = clampFloat(ACC_DEADBAND_SIGMAS * std_wy * acc_gain * ACC_G_TO_MMS2,
                                      ACC_DEADBAND_MIN, ACC_DEADBAND_MAX);
    acc_deadband_world_z = clampFloat(ACC_DEADBAND_SIGMAS * std_wz * acc_gain * ACC_G_TO_MMS2,
                                      ACC_DEADBAND_MIN, ACC_DEADBAND_MAX);

    std_am *= acc_gain;
    tol_acc_std    = fmax(3.0f * std_am, 0.003f);
    tol_acc_offset = fmax(6.0f * std_am, 0.012f);
    tol_gyro       = fmax(mean_gm + 6.0f * std_gm, 3.0f);

#if VERBOSE_STARTUP
    Serial.print(F("# OK samples=")); Serial.print(collected);
    Serial.print(F(" rejected=")); Serial.println(rejected);
    Serial.print(F("# Accel scale gain=")); Serial.print(acc_gain, 5);
    Serial.print(F("  (raw |a| was ")); Serial.print(mean_am, 5);
    Serial.println(F(" g at rest; 1.00000 would be perfect)"));
    Serial.print(F("# Bias mm/s^2 x=")); Serial.print(acc_bias_world_x, 2);
    Serial.print(F(" y=")); Serial.print(acc_bias_world_y, 2);
    Serial.print(F(" z=")); Serial.println(acc_bias_world_z, 2);
    Serial.print(F("# Accel deadband mm/s^2 x=")); Serial.print(acc_deadband_world_x, 1);
    Serial.print(F(" y=")); Serial.print(acc_deadband_world_y, 1);
    Serial.print(F(" z=")); Serial.println(acc_deadband_world_z, 1);
    Serial.print(F("# ZUPT acc_off<")); Serial.print(tol_acc_offset, 4);
    Serial.print(F(" acc_std<")); Serial.print(tol_acc_std, 4);
    Serial.print(F(" gyro<")); Serial.println(tol_gyro, 3);
#endif
}

/* ---------------- setup / loop -------------------------------------- */

void setup()
{
    Serial.begin(SERIAL_BAUD);
    delay(400);

    Wire.begin();
    Wire.setClock(I2C_CLOCK_HZ);
    delay(100);

    // Command the IMU to its fastest internal refresh (register 0x02):
    // 0=10Hz 1=50Hz 2=100Hz 3=200Hz. We want 200Hz so the chip recomputes
    // orientation fast enough to capture quick rotations - the finer
    // temporal detail we're after comes from HERE (more angle updates per
    // second at the source), not from a fancier downstream filter.
    // NOTE: this setting may not persist a full power cycle, so we write it
    // every startup rather than assuming the module holds it.
    iic_write(0x02, 3);
    delay(20);

    byte td = 1;
    bool td_ok = iic_read(0x02, &td, 1);
    if (td_ok) {
        switch (td) {
            case 0: delay_t = 100; break;
            case 1: delay_t = 20;  break;
            case 2: delay_t = 10;  break;
            case 3: delay_t = 5;   break;
            default: delay_t = 20; break;
        }
    } else {
        delay_t = 20;
#if VERBOSE_STARTUP
        Serial.println(F("# WARNING: first IMU read failed. Check SDA/SCL/power/address."));
#endif
    }
    delay(delay_t);

    attachInterrupt(digitalPinToInterrupt(2), Exti, RISING);

    setupRangeSensors();

    kalmanInit(&kf_acc_x,  0.02f, 0.05f, 10.0f);
    kalmanInit(&kf_acc_y,  0.02f, 0.05f, 10.0f);
    kalmanInit(&kf_acc_z,  0.02f, 0.05f, 10.0f);
    kalmanInit(&kf_gyro_x, 0.05f, 0.5f,  10.0f);
    kalmanInit(&kf_gyro_y, 0.05f, 0.5f,  10.0f);
    kalmanInit(&kf_gyro_z, 0.05f, 0.5f,  10.0f);
    kalmanInit(&kf_dist,   0.5f,  9.0f,  1000.0f);
    kalmanInit(&kf_dist2,  0.5f,  9.0f,  1000.0f);
    kalmanInit(&kf_dist3,  0.5f,  9.0f,  1000.0f);
    kalmanInit(&kf_dist4,  0.5f,  9.0f,  1000.0f);
    kalmanInit(&kf_dist5,  0.5f,  9.0f,  1000.0f);

    posvelInit(&kf_pos_x, 0.0f, 0.0f, 1.0f, 1.0f);
    posvelInit(&kf_pos_y, 0.0f, 0.0f, 1.0f, 1.0f);
    posvelInit(&kf_pos_z, 0.0f, 0.0f, 1.0f, 1.0f);

    last_sample_ms = millis();
    calibrate();

    last_update_us = micros();
    last_print_ms  = millis();
    last_diag_ms   = millis();
}

void loop()
{
    serviceSerialCommands();
    serviceDiagnostics();
    serviceRangeSensors();       // non-blocking; takes whatever is ready

    if (!sampleReady()) return;
    if (!readIMU())     return;

    unsigned long now_us = micros();
    float dt = (now_us - last_update_us) / 1000000.0f;
    last_update_us = now_us;
    if (dt <= 0.0f || dt > 0.25f) dt = delay_t / 1000.0f;

    // acc_gain removes the datasheet-vs-reality scale error. Without it a
    // half-percent error becomes ~50 mm/s^2 of phantom vertical
    // acceleration the moment you tilt away from the calibration pose.
    float acc_x_g = my_95Q.acc_x * ACC_SCALE * acc_gain;
    float acc_y_g = my_95Q.acc_y * ACC_SCALE * acc_gain;
    float acc_z_g = my_95Q.acc_z * ACC_SCALE * acc_gain;

    float gyro_x_dps = my_95Q.gyro_x * GYRO_SCALE;
    float gyro_y_dps = my_95Q.gyro_y * GYRO_SCALE;
    float gyro_z_dps = my_95Q.gyro_z * GYRO_SCALE;

    float acc_x_mms2 = kalmanUpdate(&kf_acc_x, acc_x_g) * ACC_G_TO_MMS2;
    float acc_y_mms2 = kalmanUpdate(&kf_acc_y, acc_y_g) * ACC_G_TO_MMS2;
    float acc_z_mms2 = kalmanUpdate(&kf_acc_z, acc_z_g) * ACC_G_TO_MMS2;

    float gyro_x_filt = kalmanUpdate(&kf_gyro_x, gyro_x_dps);
    float gyro_y_filt = kalmanUpdate(&kf_gyro_y, gyro_y_dps);
    float gyro_z_filt = kalmanUpdate(&kf_gyro_z, gyro_z_dps);

    // --- Orientation EKF: fuse gyro + accel + mag into a quaternion ------
    // Replaces the GY-95T's pre-fused angles with our own 9-DOF estimate,
    // so gyro-bias drift is learned/removed and fast rotation is tracked
    // from the raw gyro at full rate.
#if USE_ORIENTATION_EKF
    float ekf_roll, ekf_pitch, ekf_yaw;
    {
        float gx = gyro_x_dps * 0.017453293f;   // deg/s -> rad/s
        float gy = gyro_y_dps * 0.017453293f;
        float gz = gyro_z_dps * 0.017453293f;
        if (!ekf.inited) {
            ekfInit(&ekf);
            ekfSeedFromAccelMag(&ekf, acc_x_g, acc_y_g, acc_z_g,
                                (float)my_95Q.mag_x, (float)my_95Q.mag_y,
                                (float)my_95Q.mag_z);
        }
        ekfPredict(&ekf, gx, gy, gz, dt);
        ekfCorrectVector(&ekf, acc_x_g, acc_y_g, acc_z_g,
                         0.0f, 0.0f, GRAVITY_SIGN * 1.0f, ekf.Ra);
        ekfCorrectVector(&ekf, (float)my_95Q.mag_x, (float)my_95Q.mag_y,
                         (float)my_95Q.mag_z, 1.0f, 0.0f, 0.0f, ekf.Rm);
        ekfEuler(&ekf, &ekf_roll, &ekf_pitch, &ekf_yaw);
    }
    float ori_roll  = ekf_roll;
    float ori_pitch = ekf_pitch;
    float ori_yaw   = ekf_yaw - yaw_ref_deg;   // keep start-yaw zeroing
#else
    float ori_roll  = my_95Q.roll  / 100.0f;
    float ori_pitch = my_95Q.pitch / 100.0f;
    float ori_yaw   = referencedYaw();
#endif
    g_ori_roll = ori_roll; g_ori_pitch = ori_pitch; g_ori_yaw = ori_yaw;

    // Navigation channel uses raw accel: the posvel filter has its own
    // noise model, so smoothing first would double-count the filtering.
    float wx_g, wy_g, wz_g;
    rotateBodyToWorld(acc_x_g, acc_y_g, acc_z_g,
                      ori_roll, ori_pitch, ori_yaw, &wx_g, &wy_g, &wz_g);

    float res_x = wx_g * ACC_G_TO_MMS2;
    float res_y = wy_g * ACC_G_TO_MMS2;
    float res_z = (wz_g - GRAVITY_SIGN * 1.0f) * ACC_G_TO_MMS2;

    float world_ax = res_x - acc_bias_world_x;
    float world_ay = res_y - acc_bias_world_y;
    float world_az = res_z - acc_bias_world_z;

    float acc_mag_g  = sqrt(acc_x_g*acc_x_g + acc_y_g*acc_y_g + acc_z_g*acc_z_g);
    float gyro_mag_d = sqrt(gyro_x_dps*gyro_x_dps + gyro_y_dps*gyro_y_dps + gyro_z_dps*gyro_z_dps);
    statPush(acc_mag_g, gyro_mag_d);

    bool stat_raw = statIsStationary();
    if (!stat_raw) stationary_since_ms = 0;
    else if (stationary_since_ms == 0) stationary_since_ms = millis();
    bool is_stationary = stat_raw && (millis() - stationary_since_ms >= STAT_HOLD_MS);

    // Tiny residual accelerations are the clamp-maker: double integration
    // turns sensor noise and leftover bias into fake position. Use the
    // startup still noise floor as a soft deadband before prediction. If
    // the stationary detector is already quiet, feed the integrator exact
    // zero acceleration immediately; ZUPT below will handle velocity.
    if (stat_raw) {
        world_ax = 0.0f;
        world_ay = 0.0f;
        world_az = 0.0f;
    } else {
        world_ax = accelSoftDeadband(world_ax, acc_deadband_world_x);
        world_ay = accelSoftDeadband(world_ay, acc_deadband_world_y);
        world_az = accelSoftDeadband(world_az, acc_deadband_world_z);
    }

    posvelPredict(&kf_pos_x, world_ax, dt, Q_ACCEL_VAR);
    posvelPredict(&kf_pos_y, world_ay, dt, Q_ACCEL_VAR);
    posvelPredict(&kf_pos_z, world_az, dt, Q_ACCEL_VAR);

#if USE_RANGE_CORRECTION
    applyRangeCorrection(is_stationary);
#endif

    if (is_stationary) {
        posvelZUPT(&kf_pos_x, 1.0f);
        posvelZUPT(&kf_pos_y, 1.0f);
        posvelZUPT(&kf_pos_z, 1.0f);

        acc_bias_world_x += BIAS_TRACK_A * (res_x - acc_bias_world_x);
        acc_bias_world_y += BIAS_TRACK_A * (res_y - acc_bias_world_y);
        acc_bias_world_z += BIAS_TRACK_A * (res_z - acc_bias_world_z);
    } else if (VEL_TAU_S > 0.0f) {
        float leak = exp(-dt / VEL_TAU_S);
        posvelLeak(&kf_pos_x, leak);
        posvelLeak(&kf_pos_y, leak);
        posvelLeak(&kf_pos_z, leak);
    }

    // Anti-clamp: on any axis with NO locked sensor, gently leak position
    // toward zero so dead-reckoning drift decays instead of running into the
    // display clamp. A sensor-corrected axis is skipped (held by its sensor).
    // X is covered if EITHER X sensor (ch1 -X or ch4 +X) is locked; Y by
    // either forward sensor (ch2 or ch5); Z by the up sensor (ch3).
#if USE_RANGE_CORRECTION
    if (POS_LEAK_TAU_S > 0.0f && !is_stationary) {
        float pleak = exp(-dt / POS_LEAK_TAU_S);
        bool x_locked = (ch1.state == 2) || (ch4.state == 2);
        bool y_locked = (ch2.state == 2) || (ch5.state == 2);
        bool z_locked = (ch3.state == 2);
        if (!x_locked) posLeakToZero(&kf_pos_x, pleak);
        if (!y_locked) posLeakToZero(&kf_pos_y, pleak);
        if (!z_locked) posLeakToZero(&kf_pos_z, pleak);
    }
#endif

    unsigned long now_ms = millis();
    if (now_ms - last_print_ms < (unsigned long)(1000 / PRINT_HZ)) return;
    last_print_ms = now_ms;

    // --- Core: sent every line, this is what moves the model ---
    Serial.print(F("ro:"));   Serial.print(g_ori_roll, 1);
    Serial.print(F(",pi:"));  Serial.print(g_ori_pitch, 1);
    Serial.print(F(",ya:"));  Serial.print(g_ori_yaw, 1);
    Serial.print(F(",px:"));  Serial.print(kf_pos_x.pos, 1);
    Serial.print(F(",py:"));  Serial.print(kf_pos_y.pos, 1);
    Serial.print(F(",pz:"));  Serial.print(kf_pos_z.pos, 1);
    Serial.print(F(",st:"));  Serial.print(is_stationary ? 1 : 0);

    // --- Extras: one group per line, cycling. Each refreshes at
    //     PRINT_HZ / 5, which is plenty for a numeric readout. ---
    switch (extras_group) {
    case 0:
        Serial.print(F(",ax:")); Serial.print(acc_x_mms2, 0);
        Serial.print(F(",ay:")); Serial.print(acc_y_mms2, 0);
        Serial.print(F(",az:")); Serial.print(acc_z_mms2, 0);
        break;
    case 1:
        Serial.print(F(",gx:")); Serial.print(gyro_x_filt, 2);
        Serial.print(F(",gy:")); Serial.print(gyro_y_filt, 2);
        Serial.print(F(",gz:")); Serial.print(gyro_z_filt, 2);
        break;
    case 2:
        Serial.print(F(",mx:")); Serial.print(my_95Q.mag_x);
        Serial.print(F(",my:")); Serial.print(my_95Q.mag_y);
        Serial.print(F(",mz:")); Serial.print(my_95Q.mag_z);
        break;
    case 3:
        // Channel 1 (X / right): distance, state, innovation.
        Serial.print(F(",d1:"));  Serial.print(dist1_mm, 0);
        Serial.print(F(",r1s:")); Serial.print(ch1.state);
        Serial.print(F(",r1i:")); Serial.print(ch1.innov, 1);
        break;
    case 4:
        // Channel 2 (Y / forward): distance, state, innovation.
        Serial.print(F(",d2:"));  Serial.print(dist2_mm, 0);
        Serial.print(F(",r2s:")); Serial.print(ch2.state);
        Serial.print(F(",r2i:")); Serial.print(ch2.innov, 1);
        break;
    case 5:
        // Channel 3 (Z / up): distance, state, innovation, plus temp.
        Serial.print(F(",d3:"));  Serial.print(dist3_mm, 0);
        Serial.print(F(",r3s:")); Serial.print(ch3.state);
        Serial.print(F(",r3i:")); Serial.print(ch3.innov, 1);
        Serial.print(F(",tp:"));  Serial.print(my_95Q.temp / 100.0, 1);
        break;
    case 6:
        // Channel 4 (+X now): distance, state, innov.
        Serial.print(F(",d4:"));  Serial.print(dist4_mm, 0);
        Serial.print(F(",r4s:")); Serial.print(ch4.state);
        Serial.print(F(",r4i:")); Serial.print(ch4.innov, 1);
        break;
    case 7:
        // Second forward sensor (d5) + surface yaw angle from the forward
        // pair. Angle valid only when BOTH forward sensors see a target.
        Serial.print(F(",d5:"));  Serial.print(dist5_mm, 0);
        Serial.print(F(",r5s:")); Serial.print(ch5.state);
        if (dist2_mm >= 0.0f && dist5_mm >= 0.0f) {
            float yaw_surf = atan2(dist5_mm - dist2_mm,
                                   FWD_PAIR_SEPARATION_MM) * 57.29578f;
            Serial.print(F(",ya2:")); Serial.print(yaw_surf, 1);
        } else {
            Serial.print(F(",ya2:")); Serial.print(F("nan"));
        }
        break;
    default:
        // World-frame acceleration (gravity removed), what drives position.
        Serial.print(F(",wax:")); Serial.print(world_ax, 0);
        Serial.print(F(",way:")); Serial.print(world_ay, 0);
        Serial.print(F(",waz:")); Serial.print(world_az, 0);
        break;
    }
    if (++extras_group > 8) extras_group = 0;

    Serial.println();
}

/* ---------------- low level ----------------------------------------- */

void Exti()
{
    ready_Ok = 1;
    int_count++;
}

bool iic_read(unsigned char add, unsigned char *data, unsigned char len)
{
    Wire.beginTransmission(iic_add);
    Wire.write(add);
    if (Wire.endTransmission(false) != 0) return false;

    byte received = Wire.requestFrom(iic_add, (int)len);
    if (received != len) return false;

    for (byte j = 0; j < len; j++) *data++ = Wire.read();
    return true;
}

void iic_write(char add, unsigned char data)
{
    Wire.beginTransmission(iic_add);
    Wire.write((uint8_t)add);
    Wire.write((uint8_t)data);
    Wire.endTransmission();
}
